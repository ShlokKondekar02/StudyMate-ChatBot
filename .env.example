# StudyMate AI - Environment Configuration Example
# Copy this file to .env (e.g. backend/.env) and fill in your actual values.

# 1. Groq API Key
# Sign up and generate a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Groq LLM Model Identifier
# Available Groq Llama production models:
# - llama-3.3-70b-versatile (Recommended: State-of-the-art 70B reasoning & fast)
# - llama-3.1-8b-instant (Fastest inference & lightweight)
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Server Configuration (Optional)
PORT=8000
HOST=127.0.0.1
