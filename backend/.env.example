# StudyMate AI - Backend Environment Configuration Example
# Copy this file to .env (backend/.env) and insert your Groq API key.

# 1. Groq API Key (Required for live AI responses)
# Generate a free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Configurable Groq Llama Model
# Currently supported high-performance models on Groq:
# - llama-3.3-70b-versatile (Default & Recommended)
# - llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Server Configuration
PORT=8000
HOST=127.0.0.1
